#include <system\CommonRef\Servo.txt>
#param FUNCTION_USED
void SYS_Servo_Clear()
{
	#.舵机.driver.D.D0_OUT = 0;
}
#param FUNCTION_USED
void SYS_Servo_SetPin()
{
	#asm "sbrc r31,0"
	#.舵机.driver.D.D0_OUT = 1;
	#asm "sbrs r31,0"
	#.舵机.driver.D.D0_OUT = 0;
}

//*******************************************************
OS0 =
#include <system\os\os.txt>
const uint8 x0_OS_R0 = 7; OS0.RUN_NUMBER = x0_OS_R0;
const uint8 x0_OS_R1 = 0; OS0.RUN100us_NUMBER = x0_OS_R1;
const uint8 x0_OS_R2 = 12; OS0.TASK_NUMBER = x0_OS_R2;
#.start = main0;
#.OS = OS0;

void main0()
{
	OS0.OS_init();
	控制器.OS_init();
	串口通信.OS_init();
	液晶屏.OS_init();
	信息显示器.OS_init();
	矩阵键盘.OS_init();
	无线遥控器.OS_init();
	PPM遥控器.OS_init();
	点阵屏.OS_init();
	湿度传感器.OS_init();
	灯带.OS_init();
	称重传感器.OS_init();
	舵机.OS_init();
	四按钮.OS_init();
	延时器.OS_init();
	OS0.CreateDriver( (#addr 控制器.OS_run), 控制器.OS_time );
	OS0.CreateDriver( (#addr 矩阵键盘.OS_run), 矩阵键盘.OS_time );
	OS0.CreateDriver( (#addr 无线遥控器.OS_run), 无线遥控器.OS_time );
	OS0.CreateDriver( (#addr PPM遥控器.OS_run), PPM遥控器.OS_time );
	OS0.CreateDriver( (#addr 湿度传感器.OS_run), 湿度传感器.OS_time );
	OS0.CreateDriver( (#addr 舵机.OS_run), 舵机.OS_time );
	OS0.CreateDriver( (#addr 四按钮.OS_run), 四按钮.OS_time );
	OS0.CreateTask( #addr dispatch );
	SYS_Servo.OS_init();
	OS_VarInit();
	液晶屏.打开背光();
	更新液晶屏();
	OS0.Start();
	dispatch:
	forever {
		控制器.OS_thread();
		串口通信.OS_thread();
		if( 串口通信.OS_EventFlag.0(bit) == 1 ) {
			串口通信.OS_EventFlag.0(bit) = 0;
			处理串口命令();
		}
		液晶屏.OS_thread();
		点阵屏.OS_thread();
		灯带.OS_thread();
		主循环任务();
		OS0.Schedule();
		控制器.OS_ClearWatchDog();
	}
}

#param userspaceon
int32 系统状态;              // 0=运行, 1=暂停, 2=报警
int32 手动模式;              // 0=自动, 1=手动
int32 当前湿度;
int32 最新重量;
int32 轻货阈值;
int32 重货阈值;
int32 货物编号;
int32 上次湿度时间;
int32 上次生成时间;
int32 下次间隔;
int32 当前时间;
int32 点阵图标;

int32 历史时间[10];
int32 历史重量[10];
int32 历史类别[10];          // 0=轻, 1=中, 2=重
int32 历史写位置;
int32 历史有效数;

int32 队列编号[20];
int32 队列重量[20];
int32 队列时间[20];
int32 队列时[20];
int32 队列分[20];
int32 队列秒[20];
int32 队首索引;
int32 队尾索引;
int32 队列长度;

int32 随机种子;
int32 灯号;
int32 临时编号;
int32 临时重量;
int32 临时时间;
int32 临时时;
int32 临时分;
int32 临时秒;
int32 历史读位置;
int32 上次矩阵键值;
int32 串口命令;
int32 串口忽略字符数;
int32 串口已处理;
int32 队列读位置;
int32 队列读索引;
int32 串口解析模式;          // 0=普通命令, 1=解析 THRES 第一个数字, 2=解析第二个数字
int32 串口数字值;
int32 串口有数字;
int32 串口新轻阈值;
int32 串口新重阈值;
int32 清理索引;
int32 手动前状态;
int32 遥控A上次;
int32 遥控B上次;
int32 遥控C上次;
int32 遥控D上次;
int32 舵机空闲标志;          // 1=空闲, 0=正在执行分拣动作
int32 临时PPM宽度;
int32 上次液晶刷新时间;

int32 取随机数( int32 最小值, int32 最大值 )
{
	随机种子 = ((随机种子 * 1103515245s) + 12345s) % 2147483647s;
	if( 随机种子 < 0s ) {
		随机种子 = 0s - 随机种子;
	}
	return 最小值 + (随机种子 % ((最大值 - 最小值) + 1s));
}

int32 读取称重重量()
{
	临时重量 = 称重传感器.数值();
	if( 临时重量 <= 0s ) {
		临时重量 = 取随机数(200s, 4500s);
	}
	if( 临时重量 > 5000s ) {
		临时重量 = 临时重量 % 5000s;
	}
	if( 临时重量 < 200s ) {
		临时重量 = 取随机数(200s, 4500s);
	}
	return 临时重量;
}

void 计算时分秒( int32 时间 )
{
	临时时 = (时间 / 3600000s) % 24s;
	临时分 = (时间 / 60000s) % 60s;
	临时秒 = (时间 / 1000s) % 60s;
}

int32 入队( int32 编号, int32 重量, int32 时间 )
{
	if( 队列长度 >= 20s ) {
		报警灯橙色闪烁();
		串口通信.发送字符串_(("QUEUE FULL DROP NEW ID="));
		串口通信.以字符串形式发送数字_((编号));
		串口通信.发送字符串_((" W="));
		串口通信.以字符串形式发送数字_((重量));
		串口通信.发送换行符();
		return 0s;
	}
	队列编号[队尾索引] = 编号;
	队列重量[队尾索引] = 重量;
	队列时间[队尾索引] = 时间;
	计算时分秒( 时间 );
	队列时[队尾索引] = 临时时;
	队列分[队尾索引] = 临时分;
	队列秒[队尾索引] = 临时秒;
	队尾索引 = (队尾索引 + 1s) % 20s;
	队列长度 = 队列长度 + 1s;
	return 1s;
}

int32 出队()
{
	if( 队列长度 > 0s ) {
		临时编号 = 队列编号[队首索引];
		临时重量 = 队列重量[队首索引];
		临时时间 = 队列时间[队首索引];
		临时时 = 队列时[队首索引];
		临时分 = 队列分[队首索引];
		临时秒 = 队列秒[队首索引];
		队首索引 = (队首索引 + 1s) % 20s;
		队列长度 = 队列长度 - 1s;
		return 1s;
	}
	return 0s;
}

void 清空队列()
{
	队首索引 = 0s;
	队尾索引 = 0s;
	队列长度 = 0s;
	清理索引 = 0s;
	loop( 20s ) {
		队列编号[清理索引] = 0s;
		队列重量[清理索引] = 0s;
		队列时间[清理索引] = 0s;
		队列时[清理索引] = 0s;
		队列分[清理索引] = 0s;
		队列秒[清理索引] = 0s;
		清理索引 = 清理索引 + 1s;
	}
}

void 清空历史()
{
	历史写位置 = 0s;
	历史有效数 = 0s;
	历史读位置 = 0s;
	清理索引 = 0s;
	loop( 10s ) {
		历史时间[清理索引] = 0s;
		历史重量[清理索引] = 0s;
		历史类别[清理索引] = 0s;
		清理索引 = 清理索引 + 1s;
	}
}

void 保存历史( int32 时间, int32 重量, int32 类别 )
{
	历史时间[历史写位置] = 时间 / 1000s;
	历史重量[历史写位置] = 重量;
	历史类别[历史写位置] = 类别;
	历史写位置 = 历史写位置 + 1s;
	if( 历史写位置 >= 10s ) {
		历史写位置 = 0s;
	}
	if( 历史有效数 < 10s ) {
		历史有效数 = 历史有效数 + 1s;
	}
}

void 设置灯带颜色( int32 红, int32 绿, int32 蓝 )
{
	灯号 = 1s;
	loop( 8s ) {
		灯带.设置第_个灯红色分量为_((灯号),(红));
		灯带.设置第_个灯绿色分量为_((灯号),(绿));
		灯带.设置第_个灯蓝色分量为_((灯号),(蓝));
		灯号 = 灯号 + 1s;
	}
}

void 报警灯橙色闪烁()
{
	设置灯带颜色(255s, 120s, 0s);
	延时器.延时_毫秒((200s));
	设置灯带颜色(0s, 0s, 0s);
}

void 显示正常图标()
{
	点阵屏.清空();
	点阵屏.点亮第_行第_列((2s),(5s));
	点阵屏.点亮第_行第_列((3s),(6s));
	点阵屏.点亮第_行第_列((4s),(7s));
	点阵屏.点亮第_行第_列((5s),(6s));
	点阵屏.点亮第_行第_列((6s),(5s));
}

void 显示报警图标()
{
	点阵屏.清空();
	点阵屏.点亮第_行第_列((3s),(2s));
	点阵屏.点亮第_行第_列((4s),(2s));
	点阵屏.点亮第_行第_列((3s),(3s));
	点阵屏.点亮第_行第_列((4s),(3s));
	点阵屏.点亮第_行第_列((2s),(4s));
	点阵屏.点亮第_行第_列((5s),(4s));
	点阵屏.点亮第_行第_列((3s),(5s));
	点阵屏.点亮第_行第_列((4s),(5s));
}

void 更新液晶屏()
{
	信息显示器.清空();
	信息显示器.在第_行第_列显示信息_((1s),(1s),("H:"));
	信息显示器.在第_行第_列向后显示数字_((1s),(5s),(当前湿度));
	信息显示器.在第_行第_列显示信息_((1s),(8s),("Q:"));
	信息显示器.在第_行第_列向后显示数字_((1s),(12s),(队列长度));
	信息显示器.在第_行第_列显示信息_((1s),(14s),("S:"));
	if( 系统状态 == 0s ) {
		信息显示器.在第_行第_列显示信息_((1s),(16s),("RUN"));
	} else if( 系统状态 == 1s ) {
		信息显示器.在第_行第_列显示信息_((1s),(16s),("PAU"));
	} else {
		信息显示器.在第_行第_列显示信息_((1s),(16s),("ALM"));
	}
	信息显示器.在第_行第_列显示信息_((2s),(1s),("W:"));
	信息显示器.在第_行第_列向后显示数字_((2s),(6s),(最新重量));
	信息显示器.在第_行第_列显示信息_((2s),(11s),("L:"));
	信息显示器.在第_行第_列向后显示数字_((2s),(13s),(轻货阈值));
	信息显示器.在第_行第_列显示信息_((3s),(1s),("Heavy:"));
	信息显示器.在第_行第_列向后显示数字_((3s),(8s),(重货阈值));
	上次液晶刷新时间 = 当前时间;
}

void 周期刷新液晶屏()
{
	if( (当前时间 - 上次液晶刷新时间) >= 500s ) {
		更新液晶屏();
	}
}

void 发送状态到串口()
{
	串口通信.发送字符串_(("STATUS H="));
	串口通信.以字符串形式发送数字_((当前湿度));
	串口通信.发送字符串_((" W="));
	串口通信.以字符串形式发送数字_((最新重量));
	串口通信.发送字符串_((" Q="));
	串口通信.以字符串形式发送数字_((队列长度));
	串口通信.发送字符串_((" S="));
	串口通信.以字符串形式发送数字_((系统状态));
	串口通信.发送换行符();
}

void 发送阈值到串口()
{
	串口通信.发送字符串_(("THRESH L="));
	串口通信.以字符串形式发送数字_((轻货阈值));
	串口通信.发送字符串_((" H="));
	串口通信.以字符串形式发送数字_((重货阈值));
	串口通信.发送换行符();
}

void 发送命令帮助到串口()
{
	串口通信.发送字符串_(("CMD GET THRES 1000 3000 HIST RESET S P E Q C W L M 1 2 3 4"));
	串口通信.发送换行符();
}

void 发送模式到串口()
{
	串口通信.发送字符串_(("MODE MANUAL="));
	串口通信.以字符串形式发送数字_((手动模式));
	串口通信.发送字符串_((" STATE="));
	串口通信.以字符串形式发送数字_((系统状态));
	串口通信.发送换行符();
}

void 发送类别到串口( int32 类别 )
{
	if( 类别 == 0s ) {
		串口通信.发送字符串_(("LIGHT"));
	} else if( 类别 == 1s ) {
		串口通信.发送字符串_(("MEDIUM"));
	} else {
		串口通信.发送字符串_(("HEAVY"));
	}
}

void 发送历史到串口()
{
	串口通信.发送字符串_(("HISTORY LEN="));
	串口通信.以字符串形式发送数字_((历史有效数));
	串口通信.发送换行符();
	历史读位置 = 0s;
	loop( 历史有效数 ) {
		清理索引 = (历史写位置 + 10s - 历史有效数 + 历史读位置) % 10s;
		串口通信.发送字符串_(("T="));
		串口通信.以字符串形式发送数字_((历史时间[清理索引]));
		串口通信.发送字符串_((" W="));
		串口通信.以字符串形式发送数字_((历史重量[清理索引]));
		串口通信.发送字符串_((" C="));
		发送类别到串口(历史类别[清理索引]);
		串口通信.发送换行符();
		历史读位置 = 历史读位置 + 1s;
	}
}

void 发送队列到串口()
{
	串口通信.发送字符串_(("QUEUE LEN="));
	串口通信.以字符串形式发送数字_((队列长度));
	串口通信.发送换行符();
	队列读位置 = 0s;
	loop( 队列长度 ) {
		队列读索引 = (队首索引 + 队列读位置) % 20s;
		串口通信.发送字符串_(("ID="));
		串口通信.以字符串形式发送数字_((队列编号[队列读索引]));
		串口通信.发送字符串_((" W="));
		串口通信.以字符串形式发送数字_((队列重量[队列读索引]));
		串口通信.发送字符串_((" T="));
		串口通信.以字符串形式发送数字_((队列时[队列读索引]));
		串口通信.发送字符串_((":"));
		串口通信.以字符串形式发送数字_((队列分[队列读索引]));
		串口通信.发送字符串_((":"));
		串口通信.以字符串形式发送数字_((队列秒[队列读索引]));
		串口通信.发送换行符();
		队列读位置 = 队列读位置 + 1s;
	}
}

void 系统复位()
{
	清空队列();
	清空历史();
	系统状态 = 0s;
	手动模式 = 0s;
	舵机空闲标志 = 1s;
	舵机.设置角度为_((90s));
	设置灯带颜色(0s, 255s, 0s);
	显示正常图标();
	更新液晶屏();
	发送状态到串口();
}

void 启动系统()
{
	系统状态 = 0s;
	串口通信.发送字符串_(("RUN"));
	串口通信.发送换行符();
	更新液晶屏();
	发送状态到串口();
}

void 暂停系统()
{
	系统状态 = 1s;
	串口通信.发送字符串_(("PAUSE"));
	串口通信.发送换行符();
	更新液晶屏();
	发送状态到串口();
}

void 启动或暂停系统()
{
	if( 系统状态 == 0s ) {
		暂停系统();
	} else {
		启动系统();
	}
}

void 紧急停止()
{
	系统状态 = 1s;
	手动模式 = 0s;
	舵机.设置角度为_((90s));
	设置灯带颜色(255s, 0s, 0s);
	显示报警图标();
	串口通信.发送字符串_(("EMERGENCY STOP"));
	串口通信.发送换行符();
	更新液晶屏();
	发送状态到串口();
}

void 灯带测试()
{
	串口通信.发送字符串_(("LIGHT TEST"));
	串口通信.发送换行符();
	设置灯带颜色(255s, 0s, 0s);
	延时器.延时_毫秒((500s));
	设置灯带颜色(0s, 255s, 0s);
	延时器.延时_毫秒((500s));
	设置灯带颜色(0s, 0s, 255s);
	延时器.延时_毫秒((500s));
	if( 系统状态 == 2s ) {
		显示报警图标();
	} else {
		设置灯带颜色(0s, 255s, 0s);
		显示正常图标();
	}
	更新液晶屏();
}

void 清空队列并反馈()
{
	清空队列();
	串口通信.发送字符串_(("QUEUE CLEAR"));
	串口通信.发送换行符();
	更新液晶屏();
	发送状态到串口();
}

void 切换手动模式()
{
	if( 手动模式 == 0s ) {
		手动模式 = 1s;
	} else {
		手动模式 = 0s;
	}
	发送模式到串口();
	更新液晶屏();
}

void 切换点阵图标()
{
	if( 点阵图标 == 0s ) {
		点阵图标 = 1s;
		显示报警图标();
	} else {
		点阵图标 = 0s;
		显示正常图标();
	}
	更新液晶屏();
}

void 手动称重一次()
{
	手动前状态 = 系统状态;
	货物编号 = 货物编号 + 1s;
	最新重量 = 读取称重重量();
	if( 入队(货物编号, 最新重量, 当前时间) == 1s ) {
		if( 系统状态 != 2s ) {
			系统状态 = 0s;
			处理分拣();
			if( 手动前状态 == 1s ) {
				系统状态 = 1s;
			}
		} else {
			串口通信.发送字符串_(("MANUAL WEIGH QUEUED ALARM"));
			串口通信.发送换行符();
		}
	}
	更新液晶屏();
	发送状态到串口();
}

void 串口提交阈值命令()
{
	if( 串口有数字 == 1s ) {
		if( 串口解析模式 == 1s ) {
			串口新轻阈值 = 串口数字值;
		} else {
			串口新重阈值 = 串口数字值;
		}
	}
	if( 串口新轻阈值 == 0s ) {
		发送阈值到串口();
	} else if( 串口新重阈值 > 串口新轻阈值 ) {
		if( 串口新轻阈值 >= 200s ) {
			if( 串口新重阈值 <= 5000s ) {
				轻货阈值 = 串口新轻阈值;
				重货阈值 = 串口新重阈值;
				串口通信.发送字符串_(("THRES OK"));
				串口通信.发送换行符();
				发送阈值到串口();
			} else {
				串口通信.发送字符串_(("THRES ERR"));
				串口通信.发送换行符();
			}
		} else {
			串口通信.发送字符串_(("THRES ERR"));
			串口通信.发送换行符();
		}
	} else {
		串口通信.发送字符串_(("THRES ERR"));
		串口通信.发送换行符();
	}
	串口解析模式 = 0s;
	串口数字值 = 0s;
	串口有数字 = 0s;
	串口新轻阈值 = 0s;
	串口新重阈值 = 0s;
	更新液晶屏();
}

void 串口解析阈值字符()
{
	if( (串口命令 == 10s) || (串口命令 == 13s) ) {
		串口提交阈值命令();
	} else if( (串口命令 >= ('0')) && (串口命令 <= ('9')) ) {
		串口数字值 = (串口数字值 * 10s) + (串口命令 - ('0'));
		串口有数字 = 1s;
	} else {
		if( 串口有数字 == 1s ) {
			if( 串口解析模式 == 1s ) {
				串口新轻阈值 = 串口数字值;
				串口解析模式 = 2s;
			} else {
				串口新重阈值 = 串口数字值;
			}
			串口数字值 = 0s;
			串口有数字 = 0s;
		}
	}
}

void 处理串口命令()
{
	串口命令 = 串口通信.获取一个数据();
	if( 串口解析模式 > 0s ) {
		串口解析阈值字符();
	} else if( 串口忽略字符数 > 0s ) {
		串口忽略字符数 = 串口忽略字符数 - 1s;
	} else {
		串口已处理 = 0s;
		if( 串口命令 == ('G') ) {
			发送状态到串口();
			发送队列到串口();
			串口忽略字符数 = 2s;
			串口已处理 = 1s;
		}
		if( 串口命令 == ('T') ) {
			串口解析模式 = 1s;
			串口数字值 = 0s;
			串口有数字 = 0s;
			串口新轻阈值 = 0s;
			串口新重阈值 = 0s;
			串口已处理 = 1s;
		}
		if( 串口命令 == ('H') ) {
			发送历史到串口();
			串口忽略字符数 = 3s;
			串口已处理 = 1s;
		}
		if( 串口命令 == ('R') ) {
			系统复位();
			串口忽略字符数 = 4s;
			串口已处理 = 1s;
		}
		if( 串口已处理 == 0s ) {
			if( 串口命令 == ('S') ) {
				启动系统();
			}
			if( 串口命令 == ('P') ) {
				暂停系统();
			}
			if( 串口命令 == ('E') ) {
				紧急停止();
			}
			if( 串口命令 == ('Q') ) {
				发送状态到串口();
				发送队列到串口();
			}
			if( 串口命令 == ('C') ) {
				清空队列并反馈();
			}
			if( 串口命令 == ('W') ) {
				手动称重一次();
			}
			if( 串口命令 == ('L') ) {
				灯带测试();
			}
			if( 串口命令 == ('M') ) {
				切换手动模式();
			}
			if( 串口命令 == ('1') ) {
				if( 轻货阈值 > 200s ) {
					轻货阈值 = 轻货阈值 - 100s;
				}
				发送阈值到串口();
			}
			if( 串口命令 == ('2') ) {
				if( 轻货阈值 < (重货阈值 - 100s) ) {
					轻货阈值 = 轻货阈值 + 100s;
				}
				发送阈值到串口();
			}
			if( 串口命令 == ('3') ) {
				if( 重货阈值 > (轻货阈值 + 100s) ) {
					重货阈值 = 重货阈值 - 100s;
				}
				发送阈值到串口();
			}
			if( 串口命令 == ('4') ) {
				if( 重货阈值 < 5000s ) {
					重货阈值 = 重货阈值 + 100s;
				}
				发送阈值到串口();
			}
		}
		更新液晶屏();
	}
}

void 检测湿度()
{
	if( (当前时间 - 上次湿度时间) >= 2000s ) {
		当前湿度 = 湿度传感器.湿度();
		if( 当前湿度 <= 0s ) {
			当前湿度 = 60s + 取随机数(0s, 20s) - 10s;
		}
		if( 当前湿度 > 80s ) {
			if( 系统状态 != 2s ) {
				串口通信.发送字符串_(("ALARM HUMIDITY HIGH"));
				串口通信.发送换行符();
			}
			系统状态 = 2s;
			设置灯带颜色(255s, 0s, 0s);
			延时器.延时_毫秒((200s));
			设置灯带颜色(0s, 0s, 0s);
			延时器.延时_毫秒((200s));
			显示报警图标();
		} else {
			if( 系统状态 == 2s ) {
				串口通信.发送字符串_(("ALARM CLEAR"));
				串口通信.发送换行符();
			}
			if( 系统状态 != 1s ) {
				系统状态 = 0s;
			}
			设置灯带颜色(0s, 255s, 0s);
			显示正常图标();
		}
		上次湿度时间 = 当前时间;
		更新液晶屏();
		发送状态到串口();
	}
}

void 生成货物()
{
	if( 系统状态 == 0s ) {
		if( (当前时间 - 上次生成时间) >= 下次间隔 ) {
			货物编号 = 货物编号 + 1s;
			最新重量 = 读取称重重量();
			if( 入队(货物编号, 最新重量, 当前时间) == 1s ) {
				更新液晶屏();
				发送状态到串口();
			}
			上次生成时间 = 当前时间;
			下次间隔 = 取随机数(500s, 3000s);
		}
	}
}

void 处理分拣()
{
	int32 类别;
	int32 角度;
	if( 系统状态 == 0s ) {
		if( 舵机空闲标志 == 1s ) {
			if( 出队() == 1s ) {
				舵机空闲标志 = 0s;
				if( 临时重量 < 轻货阈值 ) {
					类别 = 0s;
					角度 = 0s;
				} else if( 临时重量 <= 重货阈值 ) {
					类别 = 1s;
					角度 = 90s;
				} else {
					类别 = 2s;
					角度 = 180s;
				}
				舵机.设置角度为_((角度));
				延时器.延时_毫秒((500s));
				舵机.设置角度为_((90s));
				延时器.延时_毫秒((200s));
			最新重量 = 临时重量;
			保存历史(临时时间, 临时重量, 类别);
				更新液晶屏();
				串口通信.发送字符串_(("SORT ID="));
				串口通信.以字符串形式发送数字_((临时编号));
				串口通信.发送字符串_((" W="));
				串口通信.以字符串形式发送数字_((临时重量));
			串口通信.发送字符串_((" C="));
			发送类别到串口(类别);
			串口通信.发送字符串_((" ANGLE="));
			串口通信.以字符串形式发送数字_((角度));
			串口通信.发送字符串_((" ARRIVE="));
			串口通信.以字符串形式发送数字_((临时时));
			串口通信.发送字符串_((":"));
			串口通信.以字符串形式发送数字_((临时分));
			串口通信.发送字符串_((":"));
			串口通信.以字符串形式发送数字_((临时秒));
			串口通信.发送换行符();
				舵机空闲标志 = 1s;
			}
		}
	}
}

void 处理遥控与按钮()
{
	if( 矩阵键盘.按键值 != 上次矩阵键值 ) {
		if( 矩阵键盘.按键值 == 1s ) {
			if( 轻货阈值 > 200s ) {
				轻货阈值 = 轻货阈值 - 100s;
			}
		}
		if( 矩阵键盘.按键值 == 2s ) {
			if( 轻货阈值 < (重货阈值 - 100s) ) {
				轻货阈值 = 轻货阈值 + 100s;
			}
		}
		if( 矩阵键盘.按键值 == 3s ) {
			if( 重货阈值 > (轻货阈值 + 100s) ) {
				重货阈值 = 重货阈值 - 100s;
			}
		}
		if( 矩阵键盘.按键值 == 4s ) {
			if( 重货阈值 < 5000s ) {
				重货阈值 = 重货阈值 + 100s;
			}
		}
		if( 矩阵键盘.按键值 == 5s ) {
			if( 手动模式 == 0s ) {
				手动模式 = 1s;
			} else {
				手动模式 = 0s;
			}
		}
		if( 矩阵键盘.按键值 == 6s ) {
			发送阈值到串口();
		}
		if( 矩阵键盘.按键值 == 7s ) {
			发送历史到串口();
		}
		if( 矩阵键盘.按键值 == 8s ) {
			清空队列并反馈();
		}
		if( 矩阵键盘.按键值 == 9s ) {
			启动或暂停系统();
		}
		if( 矩阵键盘.按键值 == 10s ) {
			紧急停止();
		}
		if( 矩阵键盘.按键值 == 11s ) {
			系统复位();
		}
		if( 矩阵键盘.按键值 == 12s ) {
			灯带测试();
		}
		上次矩阵键值 = 矩阵键盘.按键值;
		更新液晶屏();
	}
	if( 无线遥控器.按键A按下 == 1 ) {
		if( 遥控A上次 == 0s ) {
			启动系统();
		}
		遥控A上次 = 1s;
	} else {
		遥控A上次 = 0s;
	}
	if( 无线遥控器.按键B按下 == 1 ) {
		if( 遥控B上次 == 0s ) {
			暂停系统();
		}
		遥控B上次 = 1s;
	} else {
		遥控B上次 = 0s;
	}
	if( 无线遥控器.按键C按下 == 1 ) {
		if( 遥控C上次 == 0s ) {
			系统复位();
		}
		遥控C上次 = 1s;
	} else {
		遥控C上次 = 0s;
	}
	if( 无线遥控器.按键D按下 == 1 ) {
		if( 遥控D上次 == 0s ) {
			灯带测试();
		}
		遥控D上次 = 1s;
	} else {
		遥控D上次 = 0s;
	}
	if( PPM遥控器.读取第_通道数据((1s)) > 0s ) {
		if( 手动模式 == 1s ) {
			临时PPM宽度 = PPM遥控器.读取第_通道数据((1s));
			if( 临时PPM宽度 < 1000s ) {
				临时PPM宽度 = 1000s;
			}
			if( 临时PPM宽度 > 2000s ) {
				临时PPM宽度 = 2000s;
			}
			舵机.设置角度为_(((临时PPM宽度 - 1000s) * 180s / 1000s));
		}
	}
	if( 四按钮.按钮1按下 == true ) {
		手动称重一次();
	}
	if( 四按钮.按钮2按下 == true ) {
		清空队列并反馈();
	}
	if( 四按钮.按钮3按下 == true ) {
		切换点阵图标();
		切换手动模式();
	}
	if( 四按钮.按钮4按下 == true ) {
		更新液晶屏();
		发送状态到串口();
		发送队列到串口();
	}
}

void 主循环任务()
{
	当前时间 = 当前时间 + 10s;
	检测湿度();
	处理遥控与按钮();
	生成货物();
	处理分拣();
	周期刷新液晶屏();
	延时器.延时_毫秒((10s));
}

void 可视化初始化系统()
{
	OS_VarInit();
	更新液晶屏();
	发送命令帮助到串口();
	发送状态到串口();
}

void 可视化刷新周期()
{
	当前时间 = 当前时间 + 10s;
}

void 可视化读取湿度()
{
	当前湿度 = 60s + 取随机数(0s, 20s) - 10s;
}

void 可视化湿度报警输出()
{
	系统状态 = 2s;
	设置灯带颜色(255s, 0s, 0s);
	显示报警图标();
	更新液晶屏();
	发送状态到串口();
}

void 可视化正常环境输出()
{
	if( 系统状态 != 1s ) {
		系统状态 = 0s;
	}
	设置灯带颜色(0s, 255s, 0s);
	显示正常图标();
	更新液晶屏();
}

void 可视化随机生成货物()
{
	货物编号 = 货物编号 + 1s;
	最新重量 = 读取称重重量();
	入队(货物编号, 最新重量, 当前时间);
	更新液晶屏();
	发送状态到串口();
}

void 可视化轻货分拣()
{
	舵机.设置角度为_((0s));
	延时器.延时_毫秒((700s));
	保存历史(当前时间, 最新重量, 0s);
	舵机.设置角度为_((90s));
}

void 可视化中货分拣()
{
	舵机.设置角度为_((90s));
	延时器.延时_毫秒((700s));
	保存历史(当前时间, 最新重量, 1s);
}

void 可视化重货分拣()
{
	舵机.设置角度为_((180s));
	延时器.延时_毫秒((700s));
	保存历史(当前时间, 最新重量, 2s);
	舵机.设置角度为_((90s));
}

void 可视化串口命令()
{
	处理串口命令();
}

void 可视化矩阵键盘命令()
{
	处理遥控与按钮();
}

void 可视化按钮投放货物()
{
	货物编号 = 货物编号 + 1s;
	最新重量 = 读取称重重量();
	if( 入队(货物编号, 最新重量, 当前时间) == 1s ) {
		处理分拣();
	}
	更新液晶屏();
}

void 可视化按钮清空队列()
{
	清空队列();
	更新液晶屏();
	发送状态到串口();
}

void 可视化按钮切换点阵()
{
	if( 点阵图标 == 0s ) {
		点阵图标 = 1s;
		显示报警图标();
	} else {
		点阵图标 = 0s;
		显示正常图标();
	}
	更新液晶屏();
}

void 可视化按钮发送队列()
{
	更新液晶屏();
	发送状态到串口();
	发送队列到串口();
}

