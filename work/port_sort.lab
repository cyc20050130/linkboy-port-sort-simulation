#param userspaceoff

void OS_VarInit()
{
	系统状态 = 0s;
	手动模式 = 0s;
	当前湿度 = 60s;
	最新重量 = 0s;
	轻货阈值 = 1000s;
	重货阈值 = 3000s;
	货物编号 = 0s;
	当前时间 = 0s;
	上次湿度时间 = 当前时间;
	上次生成时间 = 当前时间;
	点阵图标 = 0s;
	上次矩阵键值 = 0s;
	串口命令 = 0s;
	串口忽略字符数 = 0s;
	串口已处理 = 0s;
	串口解析模式 = 0s;
	串口数字值 = 0s;
	串口有数字 = 0s;
	串口新轻阈值 = 0s;
	串口新重阈值 = 0s;
	队列读位置 = 0s;
	队列读索引 = 0s;
	临时时 = 0s;
	临时分 = 0s;
	临时秒 = 0s;
	临时PPM宽度 = 1500s;
	上次液晶刷新时间 = -500s;
	随机种子 = 20260604s;
	下次间隔 = 取随机数(500s, 3000s);
	清空队列();
	清空历史();
	舵机空闲标志 = 1s;
	舵机.设置角度为_((90s));
	设置灯带颜色(0s, 255s, 0s);
	显示正常图标();
}

